# Supabase Configuration - Required for OTP Email

# Copy this file to .env.local and fill in your actual values from your Supabase project dashboard
# Get these values from: https://app.supabase.com/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Dodo Payments Configuration (optional for testing)
DODO_PAYMENTS_API_KEY=your_dodo_api_key_here
DODO_PAYMENTS_WEBHOOK_SECRET=your_dodo_webhook_secret_here
DODO_PAYMENTS_RETURN_URL=http://localhost:3000/success
